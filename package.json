{
  "name": "@extrafemi-ai/assay",
  "version": "0.7.0",
  "description": "Checks AI-written text against evidence: citations against CrossRef, OpenAlex and the DOI registries; quotes against their source text; figures against the materials you supplied. Each check says what it checked against, in plain words.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obasaolorunfemi-ai/assay.git"
  },
  "homepage": "https://github.com/obasaolorunfemi-ai/assay",
  "bugs": {
    "url": "https://github.com/obasaolorunfemi-ai/assay/issues"
  },
  "author": "Extrafemi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./quotes": {
      "types": "./dist/quotes.d.ts",
      "import": "./dist/quotes.js"
    },
    "./figures": {
      "types": "./dist/figures.d.ts",
      "import": "./dist/figures.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    },
    "./claims": {
      "types": "./dist/claims.d.ts",
      "import": "./dist/claims.js"
    },
    "./references": {
      "types": "./dist/references.d.ts",
      "import": "./dist/references.js"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js"
    },
    "./sourcelist": {
      "types": "./dist/sourcelist.d.ts",
      "import": "./dist/sourcelist.js"
    },
    "./attributions": {
      "types": "./dist/attributions.d.ts",
      "import": "./dist/attributions.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "import": "./dist/draft.js"
    },
    "./own": {
      "types": "./dist/own.d.ts",
      "import": "./dist/own.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js"
    },
    "./grounding": {
      "types": "./dist/grounding.d.ts",
      "import": "./dist/grounding.js"
    },
    "./links": {
      "browser": null,
      "types": "./dist/liveness.d.ts",
      "import": "./dist/liveness.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.js"
    },
    "./retractions": {
      "types": "./dist/retractions.d.ts",
      "import": "./dist/retractions.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js"
    },
    "./legal": {
      "browser": null,
      "types": "./dist/legal.d.ts",
      "import": "./dist/legal.js"
    },
    "./tally": {
      "types": "./dist/tally.d.ts",
      "import": "./dist/tally.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "corpus": "npm run build && node scripts/corpus.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run smoke",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "site": "npm run build && node site/build.mjs",
    "benchmark:template": "node scripts/benchmark-template.mjs",
    "benchmark:agreement": "node scripts/agreement.mjs",
    "site:check": "node site/check.mjs",
    "legal:live": "npm run build && node scripts/legal-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "ai",
    "citations",
    "crossref",
    "doi",
    "fabrication",
    "fact-checking",
    "figures",
    "grounding",
    "guardrails",
    "hallucination",
    "llm",
    "openalex",
    "quotes",
    "references",
    "verification"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "assay": "./bin/assay.mjs"
  }
}
