{
  // The Assay site: static files served by Cloudflare Workers Assets, plus one small Worker for the opt-in counter at /api/count.
  // The Worker runs only for /api/*; every other path is served straight from the static site without running any code.
  // Publish with `npx wrangler deploy`. See site/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assay",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "assay.extrafemi.com", "custom_domain": true }],
  "assets": {
    "directory": "./site/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
}
